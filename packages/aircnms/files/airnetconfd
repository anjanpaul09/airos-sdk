#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1
PROG=/usr/sbin/air-netconfd

. /usr/lib/aircnms/air_mode_helper.sh 2>/dev/null || true

start_service()
{
    if type is_cloud_mode >/dev/null 2>&1; then
        is_cloud_mode || return 0
    else
        [ "$(uci -q get aircnms.@aircnms[0].mode)" = "cloud" ] || return 0
    fi

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 0 0
    procd_close_instance
}

service_triggers()
{
    procd_add_reload_trigger aircnms
}

# stop_service() is not needed - procd handles stopping automatically

restart_service()
{
    stop
    sleep 1
    start
}

