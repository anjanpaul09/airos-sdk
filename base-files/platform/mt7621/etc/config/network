config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option packet_steering '1'

# --- br-lan: wan port + WiFi SSIDs bridged ---
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'wan'
	option bridge_empty '1'

config interface 'lan'
	option device 'br-lan'
	option proto 'dhcp'
	option ipv6 '0'

# --- Management: lan port, static IP ---
config device
	option name 'br-mgmt'
	option type 'bridge'
	list ports 'lan'
	option bridge_empty '1'

config interface 'mgmt'
	option device 'br-mgmt'
	option proto 'static'
	option ipaddr '192.168.188.253'
	option netmask '255.255.255.0'

# --- NAT bridge: for captive portal / NAT'd clients ---
config device
	option name 'br-nat'
	option type 'bridge'
	option bridge_empty '1'

config interface 'nat_network'
	option device 'br-nat'
	option proto 'static'
	option ipaddr '192.168.23.1'
	option netmask '255.255.255.0'
